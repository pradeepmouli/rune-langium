# ─────────────────────────────────────────────────────────────────────────────
# Studio environment variables (014-studio-prod-ready / contracts/studio-config.md)
#
# Copy this file to `.env.local` and uncomment the lines you want to override.
# Defaults are baked into `apps/studio/src/config.ts`; `.env.local` only needs
# the values you change.
# ─────────────────────────────────────────────────────────────────────────────

# LSP host base URL — connects directly to the apps/lsp-worker Cloudflare
# Worker (no Pages Function proxy). Studio appends `/ws/<sessionToken>` at
# runtime.
#   prod default: wss://www.daikonic.dev/rune-studio/api/lsp
#   for pnpm dev:full (apps/lsp-worker's own `wrangler dev`, see its
#   wrangler.toml [dev] port + .dev.vars.example for the matching
#   ALLOWED_ORIGIN override):
# VITE_LSP_WS_URL=ws://localhost:8790/rune-studio/api/lsp

# HTTP endpoint for `POST .../lsp/session` (token mint). Resolved
# independently of VITE_LSP_WS_URL (each falls back to its own same-origin
# default in src/config.ts, not derived from the other) — set both together.
# VITE_LSP_SESSION_URL=http://localhost:8790/rune-studio/api/lsp/session

# Deployment-level LSP switch. Leave enabled for normal Studio builds; set to
# `false` to suppress all remote LSP connection attempts.
# VITE_ENABLE_LSP=true

# Telemetry POST endpoint.
# When unset, defaults to `${location.origin}/api/telemetry/v1/event`.
# VITE_TELEMETRY_ENDPOINT=http://localhost:5173/api/telemetry/v1/event

# Deployment-level telemetry switch. Defaults to `false` for local/dev
# builds. Production's value is committed in `.env.production` (not set via
# Cloudflare Pages env vars — see that file's comment for why); only
# uncomment here to test the telemetry path locally.
# VITE_ENABLE_TELEMETRY=false

# Deployment-level GitHub auth switch. Set to `false` to hide the
# "Open from GitHub repository…" flow when the auth worker is not deployed.
# VITE_ENABLE_GITHUB_AUTH=true

# Deployment-level curated mirror switch. Set to `false` to hide the built-in
# reference-model buttons when the curated mirror worker is not deployed.
# VITE_ENABLE_CURATED_MIRROR=true

# Dev-mode toggle. When `true`, the status bar shows developer-only copy
# (e.g. "start the LSP server on ws://localhost:8790"). Defaults to the
# value of `import.meta.env.DEV`.
# VITE_DEV_MODE=true

# Legacy isomorphic-git clone path (FR-019). Production builds default
# to `false`; flip to `true` only when locally testing the legacy fallback.
# VITE_LEGACY_GIT_PATH=false
