# ─────────────────────────────────────────────────────────────────────────────
# Production-mode Vite env defaults (see .env.example for the full variable
# list and precedence notes).
#
# VITE_ENABLE_TELEMETRY is committed here, not left as a Cloudflare Pages
# dashboard/API env var, because Cloudflare Pages' github:push-triggered
# deploys do not reliably pick up env-var changes made via the API after the
# last such deploy — only a manually-triggered (ad_hoc/retry) deploy does
# (see README.md's Deployment section and specs/012-studio-workspace-ux/
# deploy-runbook.md Step 6). That silently reverted production telemetry to
# disabled across two separate PR merges. Vite loads this file for every
# production-mode build regardless of how the build was triggered, so this
# value can no longer go stale that way.
# ─────────────────────────────────────────────────────────────────────────────

VITE_ENABLE_TELEMETRY=true
